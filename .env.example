# FalkorTerm + local FalkorDB (copy to .env and adjust)

# Connection (used by `uv run falkorterm`)
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_GRAPH=falkorterm
FALKOR_PASSWORD=
FALKOR_TIMEOUT_MS=30000
FALKOR_MAX_ROWS=500
# FALKOR_HISTORY_PATH=  # optional; default ~/.local/share/falkorterm/history.json
# FALKOR_EXPORT_DIR=     # optional; default ~/.local/share/falkorterm/exports
# FALKOR_PROFILES_PATH=  # optional; default ~/.local/share/falkorterm/profiles.json

# Docker Compose — FalkorDB Browser UI
FALKOR_BROWSER_PORT=3000
